.venv/

# Debug / Release files
# NOTE: keep these anchored to the project root ("/debug/", "/bin/", ...).
# Unanchored "debug/" also matched nested SOURCE directories and silently
# dropped components/esp-now/src/debug/ from the repository, which broke
# cmake ("Include directory .../src/debug/include is not a directory").
/Debug/
/debug/
/Release/
/release/
/out/
/bin/
/obj/

*.code-workspace

sdkconfig
sdkconfig.old

