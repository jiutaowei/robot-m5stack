--- /dev/null
+++ b/remote/code/main/joystick/m5_i2c_bridge.h
@@ -0,0 +1,21 @@
+/*
+ * Bridge between the C joystick driver and M5Unified's C++ I2C implementation.
+ */
+#ifndef M5_I2C_BRIDGE_H
+#define M5_I2C_BRIDGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+bool m5_i2c_bridge_init(uint8_t address);
+bool m5_i2c_bridge_read(uint8_t address, uint8_t reg, uint8_t *data, size_t length);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/remote/code/main/joystick/m5_i2c_bridge.cpp b/remote/code/main/joystick/m5_i2c_bridge.cpp
new file mode 100644
--- /dev/null
+++ b/remote/code/main/joystick/m5_i2c_bridge.cpp
@@ -0,0 +1,30 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * Use the I2C bus already initialized and owned by M5Unified. The previous
+ * implementation created a legacy i2c_bus handle on the same controller,
+ * which aborts on ESP-IDF 5.5 when M5Unified uses the new driver.
+ */
+#include "m5_i2c_bridge.h"
+#include "M5Unified.h"
+
+namespace {
+constexpr uint32_t kJoystickI2cFrequency = 100000;
+}
+
+extern "C" bool m5_i2c_bridge_init(uint8_t address)
+{
+    if (!m5::M5.In_I2C.isEnabled()) {
+        m5::M5.In_I2C.begin(I2C_NUM_0, 0, 26);
+    }
+    return m5::M5.In_I2C.isEnabled() &&
+           m5::M5.In_I2C.scanID(address, kJoystickI2cFrequency);
+}
+
+extern "C" bool m5_i2c_bridge_read(uint8_t address, uint8_t reg, uint8_t *data, size_t length)
+{
+    if (!m5::M5.In_I2C.isEnabled()) {
+        return false;
+    }
+    return m5::M5.In_I2C.readRegister(address, reg, data, length, kJoystickI2cFrequency);
+}
