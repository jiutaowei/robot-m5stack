# 米宝一号后端环境变量（复制为 .env 使用，全部可省略走默认值）

# 服务监听（设备端 upload_url 指向 http://<电脑IP>:8000）
MIBAO_PORT=8000
MIBAO_HOST=0.0.0.0

# 数据目录（默认 ./data）
# MIBAO_DATA_DIR=/absolute/path/to/data

# IoT 代理目标：树莓派 Flask 执行器控制接口
MIBAO_IOT_TARGET_URL=http://10.51.1.205:5000/actuator_control
MIBAO_IOT_TIMEOUT=5

# ------------------------------------------------------------------
# 百炼（DashScope）转写 / 纪要总结
# key 从业务空间导出（04_API KEY/*.xlsx），填入后勿提交本文件（已 gitignore）
# 日志/接口展示一律以 sk-*** 掩码，严禁外泄原文
# ------------------------------------------------------------------
MIBAO_DASHSCOPE_KEY=sk-xxxxxxxxxxxxxxxx

# 公网默认可省略以下两项；专属业务空间需指向自定义端点
# MIBAO_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# MIBAO_DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型与超时（可选）
# MIBAO_QWEN_MODEL=qwen-plus
# MIBAO_ASR_MODEL=paraformer-realtime-v2
# MIBAO_LLM_TIMEOUT=120
