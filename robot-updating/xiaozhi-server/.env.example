# 米宝一号 · 广西植保 S2S 数字员工工具（ask_guangxi_phyto）环境变量样例
#
# 用法：cp .env.example .env.local，填真值后由启动器 source；或直接写进 data/.config.yaml。
# 安全：.env / .env.local 已在 .gitignore，不会入库；本文件只是占位，不含任何真密钥。
#
# 解析优先级（plugins_func/functions/ask_guangxi_phyto.py）：
#   默认值 DEFAULT_CLAIMS / DEFAULT_PLUGIN_CONFIG  <  data/.config.yaml 的 plugins.ask_guangxi_phyto  <  环境变量
# 私钥路径例外：config 的 private_key_path 优先于 HEZOR2_HEADER_PK_FILEPATH。
# 相对路径一律以 xiaozhi-server/ 为基准解析。

# ── 私钥与私钥密码（文件 或 PEM 内容，二选一）────────────────────────
HEZOR2_HEADER_PK_FILEPATH=.keys/private_key.pem
HEZOR2_HEADER_PK_PASSWORD=<client_secret>
# HEZOR_CERT_CONTENT="-----BEGIN ENCRYPTED PRIVATE KEY-----\n...\n-----END ENCRYPTED PRIVATE KEY-----\n"

# ── 应用名与数字员工 ──────────────────────────────────────────────
HEZOR2_APP_NAME=phyto_province_gx_app
# 必传：该 caller 没有配置 mode 路由，靠 workerId 直连白名单内的数字员工
WORKER_ID=ea532b59-6311-4d5b-99fb-2553d088cc67

# ── MetaInfo（JWT 载荷；字段名以官方文档为准，是 subject 而非标准 JWT 的 sub）──
HEZOR2_META_SUBJECT=广西省级植保
HEZOR2_META_SUBJECT_CODE=phyto_province_gx_app
HEZOR2_META_CALLER_ID=guangxi_ai_robot_m5stack@phyto_province_gx_app.local
# 备选（vendor 给的 .env.local 原值，2026-09-29 实测同样可用）：
# HEZOR2_META_CALLER_ID=guangxi_ai1234@phyto_province_gx_app.local
HEZOR2_META_CREATION_SLUG=guangxi_ai_chat
HEZOR2_META_CREATION_NAME=广西AI助手

# ── 注意 ────────────────────────────────────────────────────────
# 本插件不需要 HEZOR2_API_KEY：那是 OpenAI 兼容 LLM 路径（data/.config.yaml 的 HezorLLM）用的另一条链路。
# 启用插件还需在 Intent.function_call.functions 列表里加上 ask_guangxi_phyto（该列表是「替换」而非合并）。
