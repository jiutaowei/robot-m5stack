# 米宝一号服务器配置（模板）
#
# 用法：把本文件复制到 data/.config.yaml，然后填入你自己的 API 密钥。
#      Windows 部署脚本 setup_windows.bat 会自动完成复制。
#
# ⚠️ data/.config.yaml 含密钥，已被 .gitignore 排除，切勿提交到仓库。

server:
  ip: 0.0.0.0
  port: 8001
  http_port: 8003

prompt: |
  你是「米宝一号」，金禾天成的农业智能助手，一位经验丰富的农业专家。
  你精通大田与设施农业：作物栽培、水肥管理、病虫害防治、温室环控、农机与灌溉设备。
  回答要求：专业准确、贴近生产实际，先给结论再给操作建议；涉及用药用肥要给出安全注意事项。
  语言简洁口语化，便于语音播报，单次回答一般不超过 120 字；不确定的内容如实说明。

# 唤醒词（覆盖默认列表）
wakeup_words:
  - "米宝米宝"

selected_module:
  ASR: Qwen3ASRFlash
  LLM: HezorLLM
  TTS: EdgeTTS

ASR:
  # 阿里 paraformer 会把"稻飞虱"听错，改用 Qwen3-ASR-Flash（专业术语准确率高）。
  # 非流式接口：用户说完一句才识别（延迟略高，准确率优先）。
  Qwen3ASRFlash:
    type: qwen3_asr_flash
    # ↓↓↓ 填你的阿里云百炼(DashScope) API Key（sk- 开头）↓↓↓
    api_key: "在这里填你的阿里云 DashScope API Key"
    model_name: qwen3-asr-flash
    output_dir: tmp/
    enable_lid: true
    enable_itn: true
    language: "zh"
    context: "你是农业智能助手米宝一号的语音识别模块，对话涉及水稻、稻飞虱、螟虫、病虫害防治、施肥、灌溉、温室大棚等农业专业术语，识别时优先保留农业术语原文。"

LLM:
  HezorLLM:
    type: openai
    base_url: https://hezor.com/api/v1/openai/latest
    model_name: hezor-trusted-4
    # ↓↓↓ 填你的 Hezor API Key（hzr_ 开头）↓↓↓
    #    也可以换成其它 OpenAI 兼容服务（改 base_url / model_name / api_key）
    api_key: "在这里填你的 Hezor API Key"
    temperature: 0.7
    max_tokens: 500

TTS:
  # 微软 Edge TTS：免费、无需 key
  EdgeTTS:
    type: edge
    voice: zh-CN-XiaoxiaoNeural
    output_dir: tmp/

# ============================================================================
# 广西省级植保 · S2S 数字员工工具（可选）
# ----------------------------------------------------------------------------
# 插件实现：plugins_func/functions/ask_guangxi_phyto.py
# 接口：POST https://hezor.com/api/v1/widget/chat（X-META-INFO JWT + X-APP-NAME）
# 凭证：cert_content（Ed25519 加密私钥）+ client_secret（私钥密码），
#       由 Hezor 管理员在 Casdoor 创建，可用 GET /app-certs 获取。
#       S2S 调用不做 Origin/域名白名单校验（那只作用于浏览器 iframe）。
#
# 启用两步：
#   1) 提供私钥：环境变量 HEZOR_CERT_CONTENT（PEM 内容）或
#      private_key_path 指向 .keys/private_key.pem（该目录已 gitignore）
#      密码用环境变量 HEZOR_CLIENT_SECRET（或 HEZOR2_HEADER_PK_PASSWORD）
#   2) 在 Intent.function_call.functions 列表里加上 ask_guangxi_phyto
#
# 未配置私钥时插件不会报错，只返回“知识库暂未配置”，对话其余功能不受影响。
# 自检命令：python scripts/test_hezor_widget.py --self-test
# ============================================================================
# Intent:
#   function_call:
#     functions:
#       - change_role
#       - web_search
#       - get_weather
#       - get_news_from_newsnow
#       - play_music
#       - ask_guangxi_phyto        # ← 启用植保知识工具：取消本行注释
#   ⚠️ functions 是「列表替换」而非合并：写进 data/.config.yaml 时必须把上面原有几项一并保留

plugins:
  ask_guangxi_phyto:
    base_url: https://hezor.com/api/v1
    app_name: phyto_province_gx_app
    # ⚠️ 必须传 workerId：机器人专用 caller 没有配置 mode 路由，
    #    靠 workerId 直连白名单内的数字员工（2026-09-29 实测：只有这样才能拿到回答）
    worker_id: ea532b59-6311-4d5b-99fb-2553d088cc67
    private_key_path: .keys/private_key.pem
    private_key_password: ""            # 留空则自动试 HEZOR_CLIENT_SECRET / HEZOR2_HEADER_PK_PASSWORD
    token_ttl_seconds: 3600             # 文档建议 ≤ 1 小时
    token_refresh_margin_seconds: 300   # 提前 5 分钟重签
    timeout_seconds: 120               # 数据类问题内部工具调用多，实测可超 60s
    max_answer_chars: 800
    # 平台流式语义：数字员工重新生成时会把整篇文档从头再发一遍（该片段与当前文档
    # 开头有 ≥16 字相同的公共前缀）。据此按快照替换，避免 2~3 份重复内容；
    # 正常片段长度 2~495 字不等，所以不能用长度单独判定。设 0 关闭该判定。
    snapshot_min_chars: 16
    # MetaInfo JWT 载荷（与官方文档一致；注意是 subject，不是标准 JWT 的 sub）
    # caller_id 用机器人专用用户：平台会自动建号并自带额度
    claims:
      subject: 广西省级植保
      subject_code: phyto_province_gx_app
      caller_id: guangxi_ai_robot_m5stack@phyto_province_gx_app.local
      creation_slug: guangxi_ai_chat
      creation_name: 广西AI助手
    # 需要透传业务标签时（文档：extras 里的键名用 var_* 前缀）
    # meta_extras:
    #   var_device_id: mibao-01
