# 米宝一号服务器配置（模板）
#
# 用法：把本文件复制到 data/.config.yaml，然后填入你自己的 API 密钥。
#      Windows 部署脚本 setup_windows.bat 会自动完成复制。
#
# ⚠️ data/.config.yaml 含密钥，已被 .gitignore 排除，切勿提交到仓库。

server:
  ip: 0.0.0.0
  port: 8001
  http_port: 8003

prompt: |
  你是「米宝一号」，金禾天成的农业智能助手，一位经验丰富的农业专家。
  你精通大田与设施农业：作物栽培、水肥管理、病虫害防治、温室环控、农机与灌溉设备。
  回答要求：专业准确、贴近生产实际，先给结论再给操作建议；涉及用药用肥要给出安全注意事项。
  语言简洁口语化，便于语音播报，单次回答一般不超过 120 字；不确定的内容如实说明。

# 唤醒词（覆盖默认列表）
wakeup_words:
  - "米宝米宝"

# 工具调用时是否把 "% 工具名" 推到设备气泡（默认 false）。
# 对用户无意义，且会当成一条"用户消息"进对话历史，故默认关闭。
# 排查工具是否被调用时，看服务端日志的「执行工具: xxx」即可。
show_tool_name_on_device: false

# ── 决策期垫话（2026-10-08）──────────────────────────────────────────
# 「说完 → 大模型吐第一个字」之间有 1~22 秒空档（实测 58 个样本：中位 5 秒、
# 尾部 10/13/18/20/22 秒），这段时间用户听不到任何声音。超时未出字就先垫一句；
# 大模型一出字（或任何一方开始说话）自动撤销。垫话不写对话历史，不影响工具调用配对。
latency_interim:
  enabled: true
  seconds: 5.0            # 设小更敏捷，但正常闲聊（1~3 秒）也会被垫话
  texts:
    - "稍等，我看一下。"
    - "嗯，我查一下。"

selected_module:
  ASR: Qwen3ASRFlash
  LLM: HezorLLM
  TTS: EdgeTTS

ASR:
  # 阿里 paraformer 会把"稻飞虱"听错，改用 Qwen3-ASR-Flash（专业术语准确率高）。
  # 非流式接口：用户说完一句才识别（延迟略高，准确率优先）。
  Qwen3ASRFlash:
    type: qwen3_asr_flash
    # ↓↓↓ 填你的阿里云百炼(DashScope) API Key（sk- 开头）↓↓↓
    api_key: "在这里填你的阿里云 DashScope API Key"
    model_name: qwen3-asr-flash
    output_dir: tmp/
    enable_lid: true
    enable_itn: true
    language: "zh"
    context: "你是农业智能助手米宝一号的语音识别模块，对话涉及水稻、稻飞虱、螟虫、病虫害防治、施肥、灌溉、温室大棚等农业专业术语，识别时优先保留农业术语原文。"

LLM:
  HezorLLM:
    type: openai
    base_url: https://hezor.com/api/v1/openai/latest
    model_name: hezor-trusted-4
    # ↓↓↓ 填你的 Hezor API Key（hzr_ 开头）↓↓↓
    #    也可以换成其它 OpenAI 兼容服务（改 base_url / model_name / api_key）
    api_key: "在这里填你的 Hezor API Key"
    temperature: 0.7
    max_tokens: 500

TTS:
  # 微软 Edge TTS：免费、无需 key
  EdgeTTS:
    type: edge
    voice: zh-CN-XiaoxiaoNeural
    output_dir: tmp/

# ============================================================================
# 广西省级植保 · S2S 数字员工工具（可选）
# ----------------------------------------------------------------------------
# 插件实现：plugins_func/functions/ask_guangxi_phyto.py
# 接口：POST https://hezor.com/api/v1/widget/chat（X-META-INFO JWT + X-APP-NAME）
# 凭证：cert_content（Ed25519 加密私钥）+ client_secret（私钥密码），
#       由 Hezor 管理员在 Casdoor 创建，可用 GET /app-certs 获取。
#       S2S 调用不做 Origin/域名白名单校验（那只作用于浏览器 iframe）。
#
# 启用两步：
#   1) 提供私钥：环境变量 HEZOR_CERT_CONTENT（PEM 内容）或
#      private_key_path 指向 .keys/private_key.pem（该目录已 gitignore）
#      密码用环境变量 HEZOR_CLIENT_SECRET（或 HEZOR2_HEADER_PK_PASSWORD）
#   2) 在 Intent.function_call.functions 列表里加上 ask_guangxi_phyto
#
# 未配置私钥时插件不会报错，只返回“知识库暂未配置”，对话其余功能不受影响。
# 自检命令：python scripts/test_hezor_widget.py --self-test
# ============================================================================
# Intent:
#   function_call:
#     functions:
#       - web_search
#       - get_weather
#       - ask_guangxi_phyto        # ← 启用植保知识工具
#     # 不发给大模型的工具（可选）。只影响"发给大模型的清单"，工具仍可执行；
#     # 依据实测调用数据精简：22 个工具只有 6 个被调用过，清单越短挑工具越快。
#     # 恢复某个工具 = 从本列表删掉它。
#     exclude_functions:
#       - get_lunar
#       - play_music
#       - get_news_from_newsnow
#       - change_role
#   ⚠️ functions 是「列表替换」而非合并：写进 data/.config.yaml 时必须把上面原有几项一并保留

plugins:
  ask_guangxi_phyto:
    base_url: https://hezor.com/api/v1
    app_name: phyto_province_gx_app
    # ⚠️ 必须传 workerId：机器人专用 caller 没有配置 mode 路由，
    #    靠 workerId 直连白名单内的数字员工（2026-09-29 实测：只有这样才能拿到回答）
    worker_id: ea532b59-6311-4d5b-99fb-2553d088cc67
    private_key_path: .keys/private_key.pem
    private_key_password: ""            # 留空则自动试 HEZOR_CLIENT_SECRET / HEZOR2_HEADER_PK_PASSWORD
    token_ttl_seconds: 3600             # 文档建议 ≤ 1 小时
    token_refresh_margin_seconds: 300   # 提前 5 分钟重签
    timeout_seconds: 120               # 数据类问题内部工具调用多，实测可超 60s
    max_answer_chars: 800
    # 发送前剥掉「防治建议/用药方案」类措辞：实测这类词会触发上游大模型
    # content_filter（AGENT_STREAM_ERROR），让数字员工整轮失败。数据照查，
    # 防治/用药建议由机器人自己的大模型回答。设 false 关闭。
    strip_control_requests: true
    # ── 交互体验：数据类问题实测 11~308s，不能让机器人干等着 ──────────
    # ⚠️ 下面两句**只在 `progress_enabled: false` 时生效**：
    #    - async_mode: true（默认）时开头那句 ack 由框架播报；
    #    - progress_enabled: true（默认）时由 progress_messages 分级播报代替。
    interim_message: "正在为您查询数据，请稍等一下。"
    interim_delay_seconds: 0            # 0 = 立刻播报
    second_interim_message: "数据还在查询中，请再稍等一下。"
    second_interim_delay_seconds: 45    # 45 秒还没回来再说一句
    # 运行期间刷新 conn.last_activity_time，避免服务端 close_connection_no_voice_time
    # （默认 120s）判定"用户没说话"，让大模型说"时间过得真快…"然后断开
    keepalive_activity: true
    # 同一会话内、完全相同的问题并发调用时只真正发起一次（实测机器人的大模型
    # 一次会并发发 2~3 个相同调用，等于 2~3 倍额度）。只挡"同时重复"。
    dedupe_concurrent: true
    # ── 异步模式（推荐）：工具**立即返回**一句"正在查询"，后台继续查，
    #    数据回来**主动播报**。查询的 1~2 分钟里用户可以继续聊别的，
    #    插话也不会作废这一轮；而且不再有"框架工具超时"悬着。
    #    播报文案由确定性提取生成（不经过大模型，不额外耗额度）。
    #    设 false 退回阻塞式（数据交给大模型组织回答，但等待期间无法对话）。
    async_mode: true
    async_ack_message: "正在为您查询数据，请稍等一下，查到后我马上告诉您。"
    async_pending_message: "这个还在查，马上就好。"
    async_prefix: "您问的植保数据回来了，"
    # 等待超过 late_announce_seconds 才返回时，换一句更体贴的开场
    async_late_prefix: "不好意思让您久等了，"
    async_speak_wait_seconds: 30   # 数据回来时等"用户说完+机器人这轮说完"再插话，上限
    # ── 查询期间的进度播报（2026-10-08 用户体贴优化）────────────────
    # 实测植保查询 11~308 秒且方差极大；只在开头播一句"正在查询"会让用户干等。
    # 这里按时间里程碑分级播报，且**正文一开始流式返回就停止**（马上有答案了）。
    # 文案刻意不带技术细节；设 progress_enabled: false 可整体关闭。
    progress_enabled: true
    progress_messages:
      - { at: 20,  text: "数据还在查，我盯着呢，稍等一下。" }
      - { at: 60,  text: "这份省级植保数据一般要一分钟左右，您稍等。" }
      - { at: 150, text: "还在查，这次后台比较慢；一有结果我马上告诉您。" }
    progress_min_gap_seconds: 15      # 两条进度之间最小间隔，防串话
    progress_quiet_wait_seconds: 6    # 每次播报前最多等这么久让用户说完
    # ── 有界等待（避免无限等）──────────────────────────────────────
    # 单次查询总时长上限（秒，0=不限）。到点中止并给出可操作提示。
    # 注意 timeout_seconds 是"单次读超时"，对持续有流量的流式接口无效
    # （实测一次跑到 308 秒都没触发），所以必须另设总时限。
    query_deadline_seconds: 360
    # ⚠️ 仅 async_mode: true 时这个总时限说了算。若改成 blocking 模式，
    #    有效上限是框架的 tool_call_timeout（默认 180s）——它比本值先到期。
    late_announce_seconds: 90         # 超过这个时长才返回，就改口"不好意思让您久等了"
    # ── 卡死早停 + 换会话重试 ─────────────────────────────────────────
    # 平台会进"工具调用死循环"（实测 360s 零输出），此时早停并换新会话重试，
    # 比干等 6 分钟更可能拿到数据。判据是"长时间零输出"，不是"慢"。
    stall_no_output_seconds: 150
    stall_max_tool_calls: 25          # 0=关闭该判据
    retry_on_stall: 1
    # ── 短时结果缓存 ──────────────────────────────────────────────────
    # 省级周报一周才更新；同一问题短时间内重复问 → 直接播报，不查平台、不花额度。
    result_cache_seconds: 600         # 0=关闭
    cache_hit_prefix: "刚才查过了，"
    # ── 播报要求：附在查询原文前交给机器人的大模型，约束它"只播报要点、不念表格"。
    #    ⚠️ 只在**阻塞模式**（async_mode: false）生效：异步模式由确定性的
    #    _spoken_summary() 生成播报，不经过大模型，因此 speak_hint / max_answer_chars
    #    在异步模式下无效（播报长度由 _spoken_summary 自己控制）。
    #    只影响"怎么念"，不影响查到的数据（明细仍完整保留在结果里）。留空可关闭。
    speak_hint: |
      【播报要求·重要】用户是语音对话，看不到屏幕。
      如果是数据结果：只用 1~2 句话、总共不超过约 60 字，直接说出最关键的数字和结论
      （例如最新一期的发生面积、发生程度、升降趋势），不要念表格、不要逐条罗列、
      不要出现 Markdown 符号（| # *），也不要说"根据查询结果"这类套话。
      如果是需要向用户澄清的问题：照原意用一句话问回去即可。
      完整明细已在后台保留，用户追问时再展开。
    # 平台流式语义：数字员工重新生成时会把整篇文档从头再发一遍（该片段与当前文档
    # 开头有 ≥16 字相同的公共前缀）。据此按快照替换，避免 2~3 份重复内容；
    # 正常片段长度 2~495 字不等，所以不能用长度单独判定。设 0 关闭该判定。
    snapshot_min_chars: 16
    # MetaInfo JWT 载荷（与官方文档一致；注意是 subject，不是标准 JWT 的 sub）
    # caller_id 用机器人专用用户：平台会自动建号并自带额度
    claims:
      subject: 广西省级植保
      subject_code: phyto_province_gx_app
      caller_id: guangxi_ai_robot_m5stack@phyto_province_gx_app.local
      creation_slug: guangxi_ai_chat
      creation_name: 广西AI助手
    # 需要透传业务标签时（文档：extras 里的键名用 var_* 前缀）
    # meta_extras:
    #   var_device_id: mibao-01
